# Copy to .env and fill in. Never commit .env.

# --- Sign-in and security ---
OWNER_PASSWORD=choose-a-long-password
SESSION_SECRET=put-40-random-characters-here

# --- Database (docker compose fills DB_HOST itself) ---
DB_PASSWORD=choose-a-database-password

# --- AI keys ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Free key from https://api.nlt.to (optional; without it passages over 50 verses are studied without the NLT text)
NLT_API_KEY=

# --- Models ---
ORCHESTRATOR_MODEL=claude-opus-5-5
WRITER_A_MODEL=claude-sonnet-5-5
# Set these two to the exact model names shown in your OpenAI and Google accounts.
WRITER_B_MODEL=gpt-5.6
TRANSLATOR_MODEL=gemini-2.5-pro
# gemini or claude
TRANSLATOR=gemini

# --- Prices in US dollars per million tokens, from the OpenAI and Google price pages.
# Needed for the Costs page to price those steps. Claude prices are built in.
OPENAI_PRICE_IN=
OPENAI_PRICE_OUT=
GEMINI_PRICE_IN=
GEMINI_PRICE_OUT=

# --- Visitors ---
# false = only you (signed in) can use the site. true = open to the public.
PUBLIC_ACCESS=false
VISITOR_DAILY_LIMIT=3
# Optional: stop visitor studies for the day once visitors together have cost this many dollars. Empty = off.
VISITOR_DAILY_BUDGET_USD=

# true = no AI is called and placeholder text is shown (for testing the site only)
MOCK_AI=false
